<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Autom</AssemblyName>
    <RootNamespace>Autom</RootNamespace>
    <PackageId>Autom</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Title>Autom .NET SDK</Title>
    <Authors>Autom</Authors>
    <Company>Autom</Company>
    <Copyright>Copyright (c) 2026 Autom</Copyright>
    <Description>Official .NET SDK for the Autom SERP API.</Description>
    <PackageTags>serp-api;google-search-api;search-api;seo;api;sdk;autom</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://www.autom.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/automdev/autom-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Autom.Tests" />
  </ItemGroup>
</Project>
